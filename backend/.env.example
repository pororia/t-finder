APP_ENV=development
DATABASE_URL=postgresql+asyncpg://tfinder:tfinder_dev_password@localhost:5432/tfinder

# Cloud Run + Cloud SQL 사용 시 설정 (로컬에서는 주석 처리)
# CLOUD_SQL_INSTANCE=your-project:asia-northeast3:tfinder-db
# DATABASE_URL=postgresql+asyncpg://tfinder:PASSWORD@/tfinder

JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
FIREBASE_CREDENTIALS_PATH=./firebase-admin-sdk.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PASSWORD_ENCRYPTION_KEY=your_32_byte_fernet_key_here_b64=
CORS_ORIGINS=["http://localhost:3000","https://your-app.web.app"]
